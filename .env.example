# AI Provider Configuration
# Выберите провайдер: claude, ollama, custom
AI_PROVIDER=claude

# Claude API Settings (если AI_PROVIDER=claude)
CLAUDE_API_KEY=your_claude_api_key_here
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Ollama Settings (если AI_PROVIDER=ollama)
# Убедитесь, что Ollama запущен и доступен
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Custom API Settings (если AI_PROVIDER=custom)
# Для OpenAI-совместимых API (OpenAI, LM Studio, LocalAI и т.д.)
CUSTOM_API_BASE_URL=http://localhost:8080
CUSTOM_API_KEY=your_api_key_here_if_required
CUSTOM_API_MODEL=gpt-3.5-turbo

# Database
POSTGRES_USER=gost_user
POSTGRES_PASSWORD=gost_password
POSTGRES_DB=gost_formatter
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=/tmp/uploads
OUTPUT_DIR=/tmp/outputs

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
